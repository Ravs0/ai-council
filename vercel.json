{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/call.py": {
      "maxDuration": 60
    },
    "api/voice.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}